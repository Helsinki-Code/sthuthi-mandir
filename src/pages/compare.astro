---
import { BUSINESS } from '../site.config.js';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import UnitToggle from '../components/UnitToggle.astro';
import { products, compact, std } from '../lib/catalog.js';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'All mandirs', href: '/mandirs/' }, { name: 'Compare', href: '/compare/' }];
const data = { whatsapp: BUSINESS.phone.whatsapp, std: { ceilingClearance: std.ceilingClearance }, products: products.map(compact) };
---
<Base title="Compare mandirs side by side" description="Compare up to three Sthuthi mandirs: price, overall size, niche, weight, ceiling height, idols and pooja kit." breadcrumbs={crumbs}>
  <Breadcrumbs items={crumbs} />
  <div class="wrap" style="padding-top:var(--s-5)">
    <div class="row" style="justify-content:space-between;align-items:end">
      <div><h1 style="margin-bottom:.3rem">Compare mandirs</h1><p class="muted" style="margin:0">Choose two or three.</p></div>
      <UnitToggle />
    </div>
    <form class="compare-pickers" data-pickers aria-label="Choose mandirs to compare">
      {[1, 2, 3].map((n) => (
        <label class="field"><span class="flabel">Mandir {n}</span>
          <select name={`p${n}`}>
            <option value="">{n === 3 ? 'None (optional)' : 'Choose a mandir'}</option>
            {products.map((p) => <option value={p.sku}>{p.name} ({p.sku})</option>)}
          </select>
        </label>
      ))}
    </form>
    <div data-compare aria-live="polite"></div>
    <noscript><p>Comparison needs JavaScript. You can open each mandir's page from <a href="/mandirs/">All mandirs</a>.</p></noscript>
    <script type="application/json" data-compare-json set:html={JSON.stringify(data)} />
  </div>
</Base>
<script>
  import '../scripts/compare.js';
</script>
