# Build and server settings. Rebuild (npm run build) after changing a build setting; restart the server after changing a server setting.

# --- build ---
# Email shown on the contact page, footer, policies and schema. Leave empty to hide every email link.
CONTACT_EMAIL=
# Payments on: products priced below FULL_PAYMENT_MAX_INR can be bought online (Stripe Checkout). Everything else is WhatsApp.
PAYMENTS_ENABLED=true
# The one price threshold, in rupees. Below it: pay in full online. At or above it: WhatsApp enquiry, no payment option.
FULL_PAYMENT_MAX_INR=500000
# Consultation form endpoint (JSON POST). Submissions are also handed off to WhatsApp.
PUBLIC_CONSULT_ENDPOINT=

# --- payment server (server/server.mjs); never commit real keys ---
# Use test-mode keys (sk_test_..., pk_test_...) until the flow is signed off. The owner adds live keys.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Where confirmed orders are sent (JSON POST). Falls back to PUBLIC_CONSULT_ENDPOINT.
ORDER_ENDPOINT=
# Where webhook-confirmed orders are kept: file (ORDERS_DIR, for server/server.mjs) or stripe (PaymentIntent metadata; the Vercel functions always use stripe).
ORDER_STORE=file
# Folder where webhook-confirmed orders are stored (ORDER_STORE=file).
ORDERS_DIR=var/orders
